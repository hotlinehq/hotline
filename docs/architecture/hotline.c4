// Hotline C4 model, drawn only from the hotline repo (code, README.md, memory.md, docs/).
// It shows what is built today. Views: index = system context, containers = inside Hotline,
// proxy = the parts of hotline-proxy run.
// Colours match the hand-drawn picture docs/architecture/hotline-proxy.svg. Change both together.

specification {
  color hotline #7C3AED
  color customer #64748B
  color vendor #F97316
  color people #0E7490

  element person {
    style { shape person; color people; size small }
  }
  element system {
    style { color customer; size small }
  }
  element external {
    style { color vendor; size small }
  }
  element container {
    style { color hotline; size medium }
  }
  element component {
    style { shape component; color hotline; size small }
  }
  element store {
    style { shape cylinder; color hotline; size small }
  }
}

model {
  operator = person 'Operator' 'Writes the config and vendor specs, runs the proxy'

  apps = system 'Your services' 'Call vendor APIs over HTTP and WebSocket, with no code change'
  redirect = system 'Network redirect' 'Sends plain http calls to the proxy (transparent ingress)'
  macApps = system 'Mac apps' 'Programs on a Mac that cannot be told about a proxy'
  captureHelper = system 'Hotline Capture' 'macOS system extension, built in its own project'
  runner = system 'Kubernetes or other runner' 'Starts the proxy and asks if it is healthy'
  otlpBackend = system 'OTLP backend' 'OpenTelemetry Collector, Grafana Cloud or similar'
  terminal = system 'Terminal' 'Standard output of the proxy'
  vendors = external 'Vendor APIs' 'Stripe, Slack webhooks, Anthropic, Kraken WebSocket, AWS: anything over HTTP or WebSocket'

  hotline = system 'Hotline' 'Checks, times and records every vendor call' {
    style { color hotline; size large }

    proxy = container 'hotline-proxy run' {
      technology 'Go program, src/hotline-proxy'
      icon tech:go
      description 'Forwards each vendor call unchanged and records how it went'

      ingress = component 'Ingress finder' {
        description 'Six ingresses: forward_proxy, url_in_path, host_header, connect, transparent, capture. Finds the integration and the vendor api'
      }
      forwarder = component 'Forwarder' {
        technology 'internal/forward'
        description 'Calls the vendor with the bytes unchanged, times DNS, connect, TLS and first byte'
      }
      guard = component 'Address guard' 'Refuses loopback and private addresses unless allowInternalIPs'
      tap = component 'Body tap' 'Passes bodies straight on, keeps a copy up to 2 MiB; cuts WebSocket messages, streamed responses (Server-Sent Events, JSON Lines, JSON sequences) and multipart uploads into items as they pass'
      checker = component 'Spec checks' {
        technology 'internal/spec, one worker per core'
        description 'Checks each side, each WebSocket message and each stream item against the OpenAPI 3.2 spec beside the call; waiting copies capped by specChecks.queueMemory'
      }
      recorder = component 'Record builder' 'Redacts secrets, builds the records and spans (per call, WebSocket session and message, stream and stream item), writes values the spec marks to copy under hotline.recorded.*, hashes each record with SHA-256'
      ledger = component 'Evidence ledger' {
        technology 'internal/ledger'
        description 'One chain per integration; a batch every 10 seconds, handed to every exporter with a signer from the vault'
      }
      vault = component 'Vault' {
        technology 'internal/vault'
        description 'Makes hourly signing keys in memory (Ed25519, or ML-DSA by choice), each with a certificate: self-signed, or signed by the authority ledger.signing.cert names'
      }
      exporters = component 'Exporters' {
        technology 'internal/export'
        description 'otlp, file and console. Each sends the records.transform labels as the resource, has a memory queue and signs its own batch record. An otlp exporter tries a busy collector again, and with queueFolder keeps on disk what does not fit in memory'
      }
      configLoader = component 'Config loader' {
        technology 'internal/config'
        description 'Reads the config, specs and certs; reloads within 5 seconds or on kill -HUP'
      }
      probes = component 'Probes' {
        description 'When calls fail to connect, checks the vendor\'s host and port (DNS, TCP, TLS, and a path trace to where the path stops) to say which side the problem is on; one per host and port, with backoff, 2 workers'
      }
      admin = component 'Admin port' '/livez and /readyz, optional pprof pages'
      telemetry = component 'Own telemetry' 'The proxy\'s own numbers, sent if telemetry is set'

      ingress -> forwarder 'call, integration'
      forwarder -> guard 'dials'
      forwarder -> tap 'bodies, frames'
      tap -> checker 'body copies, items'
      checker -> recorder 'check results'
      forwarder -> recorder 'step timings'
      recorder -> probes 'failed connection'
      probes -> ledger 'probe record'
      probes -> exporters 'probe record, trace'
      recorder -> ledger 'record hash'
      recorder -> exporters 'record, trace'
      vault -> ledger 'signer, made under ledger.signing'
      ledger -> exporters 'batch and signer'
      configLoader -> ingress 'listeners, integrations'
      configLoader -> checker 'specs, overlays'
      configLoader -> admin 'ready or not'
    }

    verify = container 'hotline-proxy verify' {
      technology 'Same Go program'
      description 'Checks a records folder: hashes, chains, signatures and their authorities up to a trusted root, with no config, key or network'
    }

    config = store 'Config and specs' 'hotline-proxy.yaml, vendor OpenAPI specs, overlays, certs'
    folder = store 'Records folder' 'File exporter output: every call as a line of JSON'
    diskQueue = store 'Disk queue folder' 'queueFolder of an otlp exporter: records and spans waiting for the collector, at most queueDisk'
  }

  apps -> hotline.proxy.ingress 'vendor calls and WebSockets: HTTP proxy, CONNECT, URL in path, Host header'
  apps -> redirect 'plain http to the vendor name'
  redirect -> hotline.proxy.ingress 'redirected connections'
  macApps -> captureHelper 'chosen apps\' connections'
  captureHelper -> hotline.proxy.ingress 'CONNECT over a socket file'
  hotline.proxy.guard -> vendors 'calls and WebSockets, unchanged, HTTPS'
  hotline.proxy.probes -> vendors 'DNS lookup, path trace, TCP connect, TLS handshake'
  hotline.proxy.configLoader -> hotline.config 'reads, watches'
  hotline.proxy.exporters -> otlpBackend 'records, traces, OTLP'
  hotline.proxy.exporters -> hotline.folder 'JSON lines'
  hotline.proxy.exporters -> hotline.diskQueue 'what does not fit in memory'
  hotline.proxy.exporters -> terminal 'two lines per call'
  hotline.proxy.telemetry -> otlpBackend 'own metrics, OTLP'
  runner -> hotline.proxy.admin 'health checks'
  operator -> hotline.config 'writes'
  operator -> hotline.verify 'runs'
  hotline.verify -> hotline.folder 'reads'
}

views {
  view index {
    title 'System context'
    include *
  }
  view containers of hotline {
    title 'Containers'
    include *
  }
  view proxy of hotline.proxy {
    title 'hotline-proxy run, its parts'
    include *
  }
}
